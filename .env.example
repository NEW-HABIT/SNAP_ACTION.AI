# HF_TOKEN: Required for Hugging Face Inference API calls.
# Get your User Access Token from https://huggingface.co/settings/tokens
HF_TOKEN="hf_your_access_token_here"

# HUGGINGFACE_MODEL: Preferred Hugging Face Vision model ID
HUGGINGFACE_MODEL="Qwen/Qwen2.5-VL-72B-Instruct"

# PORT: Server listening port
PORT=3000

